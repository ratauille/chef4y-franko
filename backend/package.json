{
  "name": "chefos-control-panel-api-backend-server",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "description": "Node backend for proxying Google Cloud API requests",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env.local server.js",
    "dev": "nodemon --env-file=.env.local server.js",
    "dev-fastify": "tsx watch src/server.ts",
    "start-fastify": "tsx src/server.ts",
    "test": "node --eval \"process.env.NODE_ENV='test'; process.env.TEST_API_URL='http://localhost:8080'; process.env.PRODUCTION_API_URL='https://chefos-backend-74980816903.us-central1.run.app'\" && tsx src/tests/leads.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@google-cloud/firestore": "^7.11.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "fastify": "^5.2.1",
    "google-auth-library": "^10.5.0",
    "node-fetch": "^3.3.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "nodemon": "^3.1.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
